; Auto-generated by LoyalCorp Manager — instance {{ instance_id }}

[loyalcorp-transport]
type=transport
protocol=udp
bind=0.0.0.0:{{ sip_port }}

[loyalcorp-registration]
type=registration
transport=loyalcorp-transport
outbound_auth=loyalcorp-auth
server_uri=sip:{{ magnus_ip }}
client_uri=sip:{{ sip_user }}@{{ magnus_ip }}
retry_interval=60
max_retries=10
contact_user={{ sip_user }}

[loyalcorp-auth]
type=auth
auth_type=userpass
username={{ sip_user }}
password={{ sip_pass }}

[loyalcorp-aor]
type=aor
contact=sip:{{ magnus_ip }}
qualify_frequency=60

[loyalcorp_trunk]
type=endpoint
transport=loyalcorp-transport
context=loyalcorp-p1-ivr
disallow=all
allow=ulaw
allow=alaw
outbound_auth=loyalcorp-auth
outbound_proxy=sip:{{ magnus_ip }}\;lr
from_user={{ sip_user }}
from_domain={{ magnus_ip }}
aors=loyalcorp-aor
direct_media=no
trust_id_inbound=yes
send_pai=yes
callerid_privacy=allowed_not_screened
